LAMBDA_NAME=vacation-manager
ALIAS=dev
# FRONT_END_URL=http://localhost:5173

# Local: Supabase session pooler (port 5432) or local Docker Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL=true
# Supabase root CA (PEM, newlines as \n). Download: Project Settings > Database > SSL Configuration
DB_CA_CERT=
