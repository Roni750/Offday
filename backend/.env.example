LAMBDA_NAME=vacation-manager
ALIAS=dev
FRONT_END_URL=http://localhost:5173

# Option A (default): local Docker Postgres from docker-compose.yml
DATABASE_URL=postgresql://offday:offday@localhost:5433/offday
DB_SSL=false

# Option B: Supabase. Session pooler (port 5432) for local dev and migrations; special characters in the
# password must be percent-encoded. Set DB_SSL=true and DB_CA_CERT to the Supabase root CA on one line,
# with line breaks written as \n (Project Settings > Database > SSL Configuration).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DB_SSL=true
# DB_CA_CERT=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
