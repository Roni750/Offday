{
  "name": "vacation-manager-backend",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "scripts": {
    "dev": "npx ts-node src/index.ts --local",
    "build": "cef-build",
    "build:full": "cef-build --full",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/db/cli.dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/cli.dataSource.ts",
    "seed": "ts-node src/db/seed.ts",
    "db:setup": "npm run migration:run && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "commoneventframework": "^1.0.19",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
